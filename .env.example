# Sao chep file nay thanh .env.local roi dien gia tri that.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

EMBEDDING_PROVIDER=local           # hosted | local
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIM=768
LOCAL_EMBEDDING_URL=http://localhost:8000

LLM_API_KEY=
GROQ_API_KEY=                    # dùng biến này để tự chọn Groq + llama-3.3-70b-versatile
GROQ_RESEARCH_MODEL=groq/compound-mini # Một web search có giới hạn domain rồi app tự tổng hợp lần hai
LEGAL_RESEARCH_DOMAINS=vbpl.vn,vanban.chinhphu.vn,moj.gov.vn,quochoi.vn,luatvietnam.vn,thuvienphapluat.vn
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=

NGUONG_DIEM_TOI_THIEU=0.35         # duoi nguong thi tra loi "khong tim thay"

# Bảo vệ POST /api/news/sync trên production. CLI news:sync không cần token.
NEWS_SYNC_TOKEN=
# Chỉ khai báo các lĩnh vực đã thực sự nạp đủ corpus luật, phân cách bằng dấu phẩy.
LEGAL_CORPUS_TOPICS=an_toan_thuc_pham,lao_dong,giao_thong,dat_dai_nha_o,nguoi_tieu_dung
